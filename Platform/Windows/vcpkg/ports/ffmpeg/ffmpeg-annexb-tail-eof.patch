+static void annexb_clear_tail(AV1DemuxContext *c)
+{
+    c->tail_control = c->tail_pending = 0;
+    c->tail_position = -1;
+    c->tail_requested = c->tail_received = 0;
+}
+
 static int annexb_read_packet(AVFormatContext *s, AVPacket *pkt)
 {
     AV1DemuxContext *const c = s->priv_data;
     uint32_t obu_unit_size;
     int64_t pos = c->pos;
     int ret, len;
+
+    if (c->tail_control < 0 || s->io_repositioned) {
+        annexb_clear_tail(c);
+        c->output_seen = 0;
+        /* Consume only the notification; this does not add/change raw seek. */
+        s->io_repositioned = 0;
+    }
+    if (c->tail_pending &&
+        (avio_tell(s->pb) != c->tail_position || s->pb->error))
+        annexb_clear_tail(c);
+    if (c->tail_control > 0) {
+        /* Permission is consumed even when its facts no longer hold. */
+        c->tail_control = 0;
+        if (c->tail_pending && c->output_seen && !s->pb->error &&
+            avio_tell(s->pb) == c->tail_position && avio_feof(s->pb) &&
+            !s->pb->error && avio_tell(s->pb) == c->tail_position) {
+            annexb_clear_tail(c);
+            av_packet_unref(pkt);
+            c->temporal_unit_size = c->frame_unit_size = 0;
+            goto end;
+        }
+        annexb_clear_tail(c);
+    }
 
 retry:
     if (avio_feof(s->pb)) {
@@ -258,10 +301,20 @@
