+            s->pb->eof_reached && !s->pb->error && avio_feof(s->pb) &&
+            !s->pb->error) {
+            c->tail_pending = 1;
+            c->tail_position = avio_tell(s->pb);
+            c->tail_requested = obu_unit_size;
+            c->tail_received = ret;
